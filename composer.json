{
    "name": "febrysan/logcentral",
    "description": "Report Laravel exceptions to a central error-log API and serve a custom HTTP 500 page.",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "laravel",
        "logging",
        "exceptions",
        "error-reporting"
    ],
    "require": {
        "php": "^8.1",
        "guzzlehttp/guzzle": "^7.2",
        "illuminate/contracts": "^8.0|^9.0|^10.0|^11.0|^12.0|^13.0",
        "illuminate/http": "^8.0|^9.0|^10.0|^11.0|^12.0|^13.0",
        "illuminate/support": "^8.0|^9.0|^10.0|^11.0|^12.0|^13.0"
    },
    "require-dev": {
        "orchestra/testbench": "^6.40|^7.0|^8.0|^9.0|^10.0|^11.0",
        "phpunit/phpunit": "^9.5|^10.0|^11.0"
    },
    "autoload": {
        "psr-4": {
            "Febrysan\\LogCentral\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Febrysan\\LogCentral\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Febrysan\\LogCentral\\LogCentralServiceProvider"
            ]
        }
    },
    "scripts": {
        "test": "phpunit"
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
